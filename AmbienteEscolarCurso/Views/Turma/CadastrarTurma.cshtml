

<h1>Cadastrar Turma</h1>
@model TurmaModel

@if(TempData["MensagemSucesso"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["MensagemSucesso"]
    </div>
}

@if(TempData["MensagemErro"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["MensagemErro"]
    </div>
}   

<form asp-action="CadastrarTurma" asp-controller="Turma" method="post">
    <div class="form-group">
        <label for="descricao">Descrição:</label>
        <input type="text" class="form-control" asp-for="Descricao" required>
        <span asp-validation-for="Descricao" class="text-danger"></span> 
    </div>
    <div class="form-group">
        <label for="descricao">Descrição:</label>
        <select class="form-control" id="descricao" asp-for="Modalidade" required>
            <option value="EAD">EAD</option>
            <option value="Presencial">Presencial</option>
            <option value="Hibrido">Hibrido</option>
        </select>
    </div>
    <div class="form-group">
        <label for="turno">Turno:</label>
        <select class="form-control" id="turno" asp-for="Turno" required>
            <option value="Mnbhã">Manhã</option>
            <option value="Tarde">Tarde</option>
            <option value="Noite">Noite</option>
        </select>
    </div>
    <div class="mt-3 d-flex justify-content-center gap-3">
        <button type="submit" class="btn btn-primary">Criar Turma</button>
        <a class="btn btn-secondary" asp-controller="Turma" asp-action="ListarTurmas">Voltar</a>
    </div>
</form>