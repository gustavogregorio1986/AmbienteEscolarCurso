@model List<TurmaModel>

<div class="mb-5 d-flex justify-content-between align-items-center">
    <h2>Listagem de Turmas</h2>
    <a class="btn btn-success" asp-action="CadastrarTurma" asp-controller="Turma">
        Cadastrar Turma
    </a>
</div>

<table class="table table-striped table-bordered" id="registros">
    <thead>
        <tr>
            <th>Id</th>
            <th>Descrição</th>
            <th>Modalidade</th>
            <th>Turno</th>
            <th>Professores</th>
            <th>Alunos</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var turma in Model)
        {
            <tr>
                <td>@turma.Id</td>
                <td>@turma.Descricao</td>
                <td>@turma.Modalidade</td>
                <td>@turma.Turno</td>
                <td>
                    <a href="#" class="professores"
                       data-idturma="@turma.Id"
                       data-nometurma="@turma.Descricao">
                        Professores
                    </a>
                </td>
                <td>
                    <a href="#" class="alunos"
                       data-idturma="@turma.Id"
                       data-nometurma="@turma.Descricao">
                        Alunos
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal Professores -->
<div class="modal fade" id="modalProfessores" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="textModalProfessores"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Nome</th>
                            <th>Matéria</th>
                            <th>Email</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Alunos -->
<div class="modal fade" id="modalAlunos" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="textModalAlunos"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Matrícula</th>
                            <th>Nome</th>
                            <th>Email</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/Turma/Turma.js"></script>
<script src="~/js/Professor/Professor.js"></script>
