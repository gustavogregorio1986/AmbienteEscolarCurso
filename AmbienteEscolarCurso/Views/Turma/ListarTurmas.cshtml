@model List<TurmaModel>

<div class="mb-5 d-flex justify-content-between align-items-center">
    <h2>Listagem de Turmas</h2>
    <a class="btn btn-success" asp-action="CadastrarTurma" asp-controller="Turma">
        Cadastrar Turma
    </a>
</div>

<table class="table table-striped table-bordered" id="registros">
    <thead>
        <tr>
            <th>Id</th>
            <th>Descrição</th>
            <th>Modalidade</th>
            <th>Turno</th>
            <th>Professores</th>
            <th>Alunos</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var turma in Model)
        {
            <tr>
                <td>@turma.Id</td>
                <td>@turma.Descricao</td>
                <td>@turma.Modalidade</td>
                <td>@turma.Turno</td>
                <td>
                    <a href="#" class="professores"
                       data-idturma="@turma.Id"
                       data-nometurma="@turma.Descricao">
                        Professores
                    </a>
                </td>
                <td>
                    <a href="#" class="alunos"
                       data-idturma="@turma.Id"
                       data-nometurma="@turma.Descricao">
                        Alunos
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="modal fade" id="modalProfessores" tabindex="-1"> 
    <div class="modal-dialog">
        <div class="modal-context">
           <div class="modal-header">
                <h5 class="moodal-title" id="textModalProfessores"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
           </div>

           <div class="modal-body">
                <table>
                  <thead>
                     <th>Id</th>
                     <th>Nome</th>
                     <th>Máteria</th>
                     <th>Email</th>
                  </thead>
                  <tbody>
                  </tbody>
                </table>
           </div>

        </div>
    </div>
</div>

<div class="modal fade" id="modalAlunos" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-context">
            <div class="modal-header">
                <h5 class="moodal-title" id="textModalAlunos"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <table>
                    <thead>
                        <th>Id</th>
                        <th>Matricula</th>
                        <th>Nome</th>
                        <th>Email</th>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>
