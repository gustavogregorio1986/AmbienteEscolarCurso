@model List<ProfessorModel>


<div class="mb-5 d-flex justify-content-between align-items-center">
    <h2>Listagem de Professores</h2>
    <a class="btn btn-success" asp-action="CadastrarProfessor" asp-controller="Professor">
        Cadastrar Professor
    </a>
</div>

@if (TempData["MensagemSucesso"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["MensagemSucesso"]
    </div>
}

@if (TempData["MensagemErro"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["MensagemErro"]
    </div>
}

<table class="table table-striped table-bordered" id="registros">
    <thead class="table-primary">
        <tr>
            <th>Id</th>
            <th>Nome</th>
            <th>Email</th>
            <th>Matéria</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var professor in Model)
        {
            <tr>
                <td>@professor.Id</td>
                <td>@professor.Nome</td>
                <td>@professor.Email</td>
                <td>@professor.Materia.Descricao</td>
                <td>
                    <a asp-action="DetalhesProfessor" asp-route-id="@professor.Id">Detalhes</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal fora de containers -->
<div class="modal fade" id="modalProfessores" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Professores da Turma: <span id="textModalProfessores"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Nome</th>
                            <th>Matéria</th>
                            <th>Email</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/Professor/Professor.js"></script>

