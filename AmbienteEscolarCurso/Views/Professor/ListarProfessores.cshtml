@model List<ProfessorModel>



<div class="mb-5 d-flex justify-content-between align-items-center">
    <h2>Listagem de Professores</h2>
    <a class="btn btn-success" asp-action="CadastrarProfessor" asp-controller="Professor">
        Cadastrar Professor
    </a>
</div>

<table class="table table-striped table-bordered" id="registros">
    <thead class="table-primary">
        <tr>
            <th>Id</th>
            <th>Nome</th>
            <th>Enail</th>
            <th>Materia</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var professor in Model)
        {
            <tr>
                <td>@professor.Id</td>
                <td>@professor.Nome</td>
                <td>@professor.Email</td>
                <td>@professor.Materia.Descricao</td>
                <td>
                   <a asp-action="DetalhesProfessor" asp-route-id="@professor.Id">Detalhes</a>
                </td>
            </tr>
        }
    </tbody>
</table>
