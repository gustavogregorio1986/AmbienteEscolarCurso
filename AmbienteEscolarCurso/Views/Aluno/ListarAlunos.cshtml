@model List<AlunoModel>

<style>
    .container {
        display: flex;
        justify-content: center;
        flex-direction: column;
    }

    .row{
        display: grid;
        justify-items: center;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        width: 100%;
     }

     .card{
         transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
        cursor: pointer;
      }

       .card:hover {
           transform: scale(1.05);
           box-shadow: 0px 10px 20px rgba(0,0,0.2);
       }

      a{
       text-decoration: none;
        color: inherit;
      }

     a.focus a:hover{
          text-decoration: none;
          color:inherit;
     }
    
</style>

<div class="mb-5 d-flex justify-content-between align-items-center">
    <h2>Lista de Alunos</h2>
    <a asp-controller="Aluno" asp-action="CadastrarAluno" class="btn btn-success">Cadastrar Aluno</a>
</div>

@if (TempData["MensagemSucesso"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["MensagemSucesso"]
    </div>
}

@if (TempData["MensagemErro"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["MensagemErro"]
    </div>
}

<div class="container mt-4">
   <div class="row">
      @foreach(var aluno in Model)
      {
           <div class="row-cols-md-6 mb-4 d-flex justify-content-center align-content-center">
               <a asp-controller="Historico" asp-action="GerarHistorico" asp-route-id="@aluno.Id">
                  <dvi class="card shadow-sm" style="min-width: 350px; max-width: 400px; width:100%">
                      <div class="card-body">
                         <h5 class="card-title">@aluno.Nome</h5>
                         <h5 class="card-text"><strong>Matrícula:</strong> @aluno.Matricula</h5>
                         <p class="card-text"><strong>Turma:</strong> @aluno.Turma.Descricao</p>
                         <p class="card-text"><strong>Data Nascimento:</strong> @aluno.DataNascimento?.ToString("dd/MM/yyyy")</p>
                     </div>
                 </dvi>
               </a>
           </div>
      }
    </div>
</div>